# =============================================================================
# LabReplay — Root .gitignore
# =============================================================================

# ── macOS system files ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[oc]
*.pyo
build/
dist/
wheels/
*.egg-info/
.eggs/
.uv/
.uv-cache/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
.env
.env.*

# ── Session / participant data — never commit raw recordings ──────────────────
Data/
!Data/images/
!Data/images/platform.png
total-recall/sessions/
total-recall/*.db

# ── Scratch / temporary work ──────────────────────────────────────────────────
scratch/
temp.py
*.tmp
*.log

# ── Binary / generated artifacts ─────────────────────────────────────────────
*.docx
learning/*.o
learning/a.out
learning/server
